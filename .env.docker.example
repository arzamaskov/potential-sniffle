APP_PORT=8080
VITE_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:5173
VITE_CORS_ORIGIN=http://localhost:8080

# Optional. Makefile fills these from the current host user by default.
# Override them only if Docker must write files as a different UID/GID.
APP_UID=1000
APP_GID=1000

DB_DATABASE=runtracker
DB_USERNAME=runtracker
DB_PASSWORD=runtracker

XDEBUG_MODE=debug,develop
